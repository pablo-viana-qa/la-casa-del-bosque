---
import '../styles/global.css';
import { site, houseGallery, amenityGroups, pricing, nightlyPrice, maps } from '../data/site';
import heroImg from '../assets/fotos/frente.jpg';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  /** Para páginas que no deben aparecer en Google (por ejemplo la 404). */
  noindex?: boolean;
}
const {
  noindex = false,
  title = 'Casa de alquiler en Balneario Iporá, Tacuarembó | La Casa del Bosque',
  description = 'Alquiler de casa en Balneario Iporá, Tacuarembó: 4 dormitorios, 2 baños, estufa a leña y jardín para hasta 8 personas, a pasos del lago. Mascotas sin cargo.',
} = Astro.props;

const base = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, base).href;
const canonical = abs(Astro.url.pathname);

const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });
const ogUrl = abs(og.src);
const ogAlt = 'Frente de La Casa del Bosque, casa de ladrillo con jardín en Balneario Iporá';

// Fotos para los buscadores (Google pide al menos 8 para alquileres vacacionales)
const gallerySrcs = [heroImg, ...houseGallery.map((p) => p.src)].filter((src, i, all) => all.indexOf(src) === i);
const gallery = await Promise.all(
  gallerySrcs.map(async (src) => abs((await getImage({ src, width: 1200, format: 'jpg' })).src)),
);

/* Datos estructurados (schema.org). La dirección completa va solo aquí, para Google;
   en la página se muestra sin número. No se marca la puntuación de Booking: Google no
   permite marcar como propias las opiniones de otro sitio. */
const home = abs('/');
const rental = {
  '@type': 'VacationRental',
  '@id': `${canonical}#casa`,
  identifier: 'la-casa-del-bosque-ipora',
  name: site.name,
  description,
  url: canonical,
  image: gallery,
  telephone: `+${site.whatsapp}`,
  hasMap: maps.directions,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'De la Tijereta 9',
    addressLocality: 'Balneario Iporá',
    addressRegion: 'Tacuarembó',
    postalCode: '45000',
    addressCountry: 'UY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  latitude: site.geo.lat,
  longitude: site.geo.lng,
  containedInPlace: { '@type': 'Place', name: 'Balneario Iporá, Tacuarembó, Uruguay' },
  // La casa entera: 4 dormitorios (3 con cama doble grande, 1 con dos individuales), 2 baños
  containsPlace: {
    '@type': 'Accommodation',
    additionalType: 'EntirePlace',
    numberOfBedrooms: 4,
    numberOfRooms: 4,
    numberOfBathroomsTotal: 2,
    floorSize: { '@type': 'QuantitativeValue', value: 210, unitCode: 'MTK' },
    occupancy: { '@type': 'QuantitativeValue', value: 8 },
    bed: [
      { '@type': 'BedDetails', numberOfBeds: 3, typeOfBed: 'Queen' },
      { '@type': 'BedDetails', numberOfBeds: 2, typeOfBed: 'Single' },
    ],
    amenityFeature: amenityGroups
      .flatMap((g) => g.items)
      .map((it) => ({ '@type': 'LocationFeatureSpecification', name: it.label, value: true })),
  },
  priceRange: `${pricing.currency}${nightlyPrice(pricing.minGuests)} – ${pricing.currency}${pricing.base} por noche`,
  currenciesAccepted: 'USD',
  checkinTime: '15:00',
  checkoutTime: '11:00',
  petsAllowed: true,
  smokingAllowed: false,
  sameAs: [site.booking],
  knowsLanguage: 'es',
};

/* WebSite: le dice a Google qué nombre mostrar para el sitio en los resultados. */
const website = {
  '@type': 'WebSite',
  '@id': `${home}#sitio`,
  name: site.name,
  alternateName: 'La Casa del Bosque Iporá',
  url: home,
  inLanguage: 'es-UY',
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [website, rental] };
---

<!doctype html>
<html lang="es-UY" data-type="place" data-radius="square">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="page-type" content="place" />
    <meta name="site-kind" content="other" />
    <meta name="page-kind" content="place" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1d3027" />
    <meta name="geo.region" content="UY-TA" />
    <meta name="geo.placename" content="Balneario Iporá, Tacuarembó" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 900)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <!--
      Kind: place · casa de alquiler
      Deal (a mano; el kit del skill no está instalado): paleta propia de la casa
      (ladrillo de la fachada, verde pino, papel de cal), Newsreader + Schibsted Grotesk,
      esquinas rectas, botón sólido + línea, hero de tres fotos de la fachada,
      momentos: galería grande (La casa), carrusel del entorno y el 8,7 en grande (Opiniones).
    -->
    <a href="#contenido" class="fixed left-4 top-4 z-[100] -translate-y-24 bg-ink px-4 py-3 text-cream focus:translate-y-0">Saltar al contenido</a>
    <slot />
  </body>
</html>
